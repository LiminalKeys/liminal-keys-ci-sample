{
  "name": "@liminalkeys/sign-action",
  "version": "0.0.0-dev",
  "private": true,
  "description": "GitHub Action: Liminal Keys cloud CI setup, enroll, sign-check, teardown",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "build": "npm run build:main && npm run build:post",
    "build:main": "ncc build src/main.js -o dist/main --minify --license licenses.txt",
    "build:post": "ncc build src/post.js -o dist/post --minify --license licenses.txt",
    "check-dist": "git diff --exit-code dist/",
    "verify:dist": "node scripts/verify-dist-load.js"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "vitest": "^3.2.4"
  }
}
